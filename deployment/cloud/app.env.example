BANIPMATCH_DEMO=1
BANIPMATCH_WORKFLOW=1
BANIPMATCH_PUBLIC=1
BANIPMATCH_RUN_MODE=engine
BANIPMATCH_PUBLIC_HOSTS=YOUR_HTTPS_HOST
BANIPMATCH_CORS_ORIGINS=https://YOUR_HTTPS_HOST
BANIPMATCH_WORKFLOW_DIR=/var/lib/banipmatch/workflow
BANIPMATCH_REFERENCE_FILE=/var/lib/banipmatch/reference/current.json
BANIPMATCH_PUSH_ENABLED=1
BANIPMATCH_VAPID_PRIVATE_KEY_FILE=/etc/banipmatch/secrets/vapid.pem
BANIPMATCH_VAPID_SUBJECT=https://YOUR_HTTPS_HOST
