      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "scenario_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "base_plan_version": {
          "type": "integer",
          "minimum": 1
        },
        "data_mode": {
          "type": "string",
          "enum": [
            "simulated",
            "observed",
            "mixed"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC RFC3339, Z suffix; UI shows Asia/Seoul."
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Location"
