{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "반입맞춤 공통 계약 v0.1.0",
  "$defs": {
    "Evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "observed",
            "simulated",
            "assumed",
            "inferred",
            "manual_verified"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "description": "UTC RFC3339, Z suffix; UI shows Asia/Seoul."
            },
            {
              "type": "null"
            }
          ]
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC RFC3339, Z suffix; UI shows Asia/Seoul."
        }
      },
      "required": [
        "kind",
        "source_ref",
        "observed_at",
        "received_at"
      ],
      "additionalProperties": false
    },
    "Location": {
      "type": "object",
      "properties": {
        "location_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "depot",
            "origin",
            "terminal"
          ]
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "location_id",
        "name",
        "kind",
        "latitude",
        "longitude",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Vehicle": {
      "type": "object",
      "properties": {
        "vehicle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "start_location_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "available_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "description": "UTC RFC3339, Z suffix; UI shows Asia/Seoul."
