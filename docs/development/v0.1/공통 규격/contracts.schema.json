        "time_change_tolerance_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "input_valid_until": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC RFC3339, Z suffix; UI shows Asia/Seoul."
        },
        "allow_wait_before_open": {
          "const": false
