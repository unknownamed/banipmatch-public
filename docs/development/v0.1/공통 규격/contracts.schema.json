        "confirmed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "description": "UTC RFC3339, Z suffix; UI shows Asia/Seoul."
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "window_id",
        "voyage_id",
        "terminal_id",
        "opens_at",
        "closes_at",
        "verification",
        "confirmed_by",
        "confirmed_at",
        "evidence"
      ],
      "additionalProperties": false
    },
    "TravelTime": {
      "type": "object",
      "properties": {
        "from_location_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
