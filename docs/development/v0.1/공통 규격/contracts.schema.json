        "state": {
          "type": "string",
          "enum": [
            "planned",
            "departed"
          ]
        },
        "frozen": {
          "type": "boolean"
        },
        "freeze_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "job_id",
        "voyage_id",
        "origin_id",
        "terminal_id",
        "return_location_id",
        "ready_at",
        "gross_weight_kg",
        "equipment_type",
        "service_minutes",
        "state",
        "frozen",
        "freeze_reason",
        "evidence"
