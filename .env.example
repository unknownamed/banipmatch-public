# PowerShell 실행 방법은 backend/README.md 참조. 이 파일은 자동으로 읽지 않음.
BANIPMATCH_DEMO=1
# fixture: 설명용 B0/B3, engine: 모의 입력 B0~B3 실계산
BANIPMATCH_RUN_MODE=fixture
# 24자 이상의 임의 값. 실제 키·개인정보를 사용하지 않음.
BANIPMATCH_DEMO_TOKEN=
BANIPMATCH_DB_PATH=local/banipmatch-demo.sqlite3
BANIPMATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# v0.2는 별도 세션/DB 사용. 실제 주소/HTTPS/배포는 대겸이 설정.
BANIPMATCH_WORKFLOW=0
BANIPMATCH_PUBLIC=0
BANIPMATCH_WORKFLOW_DIR=local/workflow
BANIPMATCH_PUBLIC_HOSTS=
# 아래 키는 서버 파일 경로만 지정. 값 자체를 Git/프론트에 넣지 않음.
BANIPMATCH_PUSH_ENABLED=0
BANIPMATCH_VAPID_PRIVATE_KEY_FILE=
# mailto 주소 또는 경로/포트 없는 HTTPS origin. 실제 운영자가 지정.
BANIPMATCH_VAPID_SUBJECT=
# 선택형 서버 수신 시험 전용. 프론트 번들에 넣지 않음. 값은 Git에 저장하지 않음.
AISSTREAM_API_KEY=
